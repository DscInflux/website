generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entity {
  id                 String    @id @default(uuid())
  userId             String
  Username           String
  displayname        String
  url                String
  banner             String
  avatar             String
  about              String
  occupation         String[]
  staff              Boolean
  birthday           DateTime?
  location           String
  gender             String
  pronouns           String
  language           String
  website            String?
  isDeveloper        Boolean
  isPartner          Boolean
  email              String?
  views              String[]
  isVerified         Boolean
  isShow             Boolean
  isEmailPrivate     Boolean
  isBirthdayPrivate  Boolean
  isLocationPrivate  Boolean
  isGenderPrivate    Boolean
  isPronounsPrivate  Boolean
  isSexualityPrivate Boolean?
  roles              String[]
  likes              String[]
  skills             String[]
  socials            Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sexuality          String?
  timeZone           String?

  @@map("entity")
}

model User {
  id           String  @id @default(cuid())
  username     String
  display_name String
  avatar       String?
  email        String? @unique
  discordId    String  @unique
  access_token String
  token        String
  is_admin     Boolean @default(false)
  is_banned    Boolean @default(false)
  locale       String
  mfa_enabled  Boolean
  banner       String
  SSOProvider  String?

  @@map("user")
}
