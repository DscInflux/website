generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entity {
  id                 String    @id @default(uuid())
  userId             String
  Username           String
  displayname        String
  url                String
  banner             String
  avatar             String
  about              String
  occupation         String[]
  staff              Boolean
  birthday           DateTime?
  location           String
  gender             String
  pronouns           String
  language           String
  website            String?
  isDeveloper        Boolean
  isPartner          Boolean
  email              String?
  isVerified         Boolean
  isShow             Boolean
  isEmailPrivate     Boolean
  isBirthdayPrivate  Boolean
  isLocationPrivate  Boolean
  isGenderPrivate    Boolean
  isPronounsPrivate  Boolean
  isSexualityPrivate Boolean?
  roles              String[]
  likes              String[]
  skills             String[]
  socials            Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sexuality          String?
  timeZone           String?
  height             Int?
  isHeightPrivate    Boolean?
  status             String?
  views              Int       @default(0)

  @@map("entity")
}

model User {
  id            String    @id @default(cuid())
  username      String
  display_name  String
  avatar        String?
  email         String?   @unique
  discordId     String?   @unique
  access_token  String
  token         String
  is_admin      Boolean   @default(false)
  is_banned     Boolean   @default(false)
  mfa_enabled   Boolean
  banner        String
  SSOProvider   String[]
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  presence      Presence  @default(Offline)

  @@map("user")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

enum Presence {
  Online
  DND
  Idle
  Offline
}
